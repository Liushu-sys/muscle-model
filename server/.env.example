# 复制为 .env 并填入真实值；.env 不入库（见 .gitignore）

# === AI Ping（主 provider）===
# 从 https://aiping.cn 控制台获取
DASHSCOPE_API_KEY=QC-在这里填真实key

# 默认用 AI Ping（OpenAI 兼容协议）
AI_PROVIDER=aiping

# AI Ping 端点与模型（一般无需改，除非要换模型）
# AIPING_BASE=https://aiping.cn/api/v1
# CHAT_MODEL=qwen-plus
# VL_MODEL=qwen-vl-max
# IMG_MODEL=wanx2.1-imageedit

# === 百炼 fallback（可选，不配就只用 AI Ping）===
# AI_PROVIDER=dashscope
# DASHSCOPE_BASE=https://dashscope.aliyuncs.com

# 服务端口
PORT=8790
