[Unit]
Description=BodyCare AI relay (DashScope forwarder)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/ai-relay
EnvironmentFile=/var/www/ai-relay/.env
ExecStart=/usr/bin/node /var/www/ai-relay/index.js
Restart=always
RestartSec=3
User=www-data
Group=www-data
# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/ai-relay/cache

[Install]
WantedBy=multi-user.target
